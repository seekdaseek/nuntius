{
  "name": "nuntius-server",
  "version": "0.1.0",
  "private": true,
  "description": "nuntius auth backend: SIWS nonce issuance + verification, Seeker Genesis Token gate",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsc && node --test --test-reporter=spec \"dist/**/*.test.js\"",
    "test:localnet": "LOCALNET_RPC=${LOCALNET_RPC:-http://127.0.0.1:8899} npm test",
    "test:meteora": "bash ../scripts/meteora-lifecycle.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana-program/system": "0.13.0",
    "@solana-program/token": "0.15.0",
    "@solana/kit": "7.1.1",
    "@solana/subscriptions": "0.5.0",
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/wallet-standard-util": "1.1.3",
    "@solana/web3.js": "1.99.0",
    "better-sqlite3": "13.0.3",
    "bigint-buffer": "file:shims/bigint-buffer",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "express": "5.2.1",
    "google-auth-library": "11.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "jayson": "5.0.0",
    "toml": "4.3.0",
    "bigint-buffer": "$bigint-buffer"
  }
}
