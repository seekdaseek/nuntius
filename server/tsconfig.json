{
  "compilerOptions": {
    "target": "ES2023",
    // node16 (not "node") so TypeScript can read packages that ship an `exports`
    // map — @solana/subscriptions resolves its CJS build only through it.
    // package.json is `type: commonjs`, so emit stays CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
