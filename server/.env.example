# nuntius server — copy to server/.env and fill in. Never commit the filled file.
# Variable names only; every value here is a placeholder.

# SIWS binding domain (bare host).
NUNTIUS_DOMAIN=ochinimus.app
PORT=8787

# Mainnet RPC including its API key. Only the server ever sees it.
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Firebase Cloud Messaging (both or neither).
FCM_SERVICE_ACCOUNT=/opt/nuntius/fcm-service-account.json
FCM_PROJECT_ID=REPLACE_ME

# --- mandatum ---
# 'mainnet' or 'localnet'. Unset = mandates disabled.
MANDATE_CLUSTER=mainnet
# Optional; mainnet falls back to HELIUS_RPC. localnet must be loopback.
MANDATE_RPC=
# SYMBOL:mint:decimals[,...]. Mainnet default is USDC.
MANDATE_MINTS=USDC:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:6
# Beta ceiling on any one mandate's per-period cap, in UI units.
MANDATE_MAX_PER_PERIOD=100
# Executor keypair file (64-number JSON). Must exist and be funded for fees on mainnet.
MANDATE_DELEGATEE=/opt/nuntius/delegatee.json
EXECUTOR_INTERVAL_MS=30000
GUARD_INTERVAL_MS=60000
# 1 enables the over-cap demo button (for the demo video). Keep 0 otherwise.
DEMO_ENDPOINTS=0

# --- legacy devnet spike (BRIEF-05), unused by mandatum ---
DELEGATION_CLUSTER=devnet
SPIKE_PAYER=
SPIKE_DELEGATEE=
